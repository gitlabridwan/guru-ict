{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuperverse-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "zuperverse-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "ClassRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ClassRoom"]}],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787",
    "AUTO_APPROVE": "false",
    "ADMIN_WA": "",
    "BILLING_URL": "",
    "GOOGLE_CLIENT_ID": ""
  }
}
