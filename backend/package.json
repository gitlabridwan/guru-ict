{
  "name": "zuperverse-backend-mandiri",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "node --check src/index.js && node --check src/room.js",
    "pretest": "wrangler deploy --dry-run --outdir .test-worker",
    "test": "node --test tests/integration.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.157.0",
    "miniflare": "5.20261103.0-beta"
  }
}
